<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBE6D3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 🔙 HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back" />

            <TextView
                android:text="Organicity Checker"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:layout_marginStart="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 📸 MAIN CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- IMAGE CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_camera"
                    android:contentDescription="Camera Icon"/>

                <TextView
                    android:text="Capture or upload food image"
                    android:textSize="14sp"
                    android:textColor="#7A5C4C"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="For best results, use good lighting"
                    android:textSize="12sp"
                    android:textColor="#A1887F"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- 📷 CAMERA BUTTON -->
            <Button
                android:id="@+id/btnCamera"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📸 Take Photo"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_green_button"
                android:layout_marginTop="16dp"/>

            <!-- 🖼️ GALLERY BUTTON -->
            <Button
                android:id="@+id/btnGallery"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="⬆ Upload from Gallery"
                android:textColor="#3E2723"
                android:background="@drawable/bg_input"
                android:layout_marginTop="12dp"/>

            <!-- 🔢 PROGRESS BAR -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"/>

            <!-- 🔢 PERCENT TEXT -->
            <TextView
                android:id="@+id/txtPercent"
                android:text="0%"
                android:textSize="14sp"
                android:textColor="#444444"
                android:visibility="gone"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- 💡 TIPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_tips"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="📸 Tips for accurate results"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="• Place item on a clean, plain surface"
                    android:textSize="14sp"
                    android:textColor="#444444"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="• Ensure good natural lighting"
                    android:textSize="14sp"
                    android:textColor="#444444"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="• Capture full item in frame"
                    android:textSize="14sp"
                    android:textColor="#444444"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="• Avoid shadows"
                    android:textSize="14sp"
                    android:textColor="#444444"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
