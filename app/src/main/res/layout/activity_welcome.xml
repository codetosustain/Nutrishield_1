<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDE1C8">

    <ImageView
        android:id="@+id/imgWelcome"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="120dp"
        android:src="@drawable/welcome_image"
        android:contentDescription="@string/welcome_image"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/txtWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_to_nnutrishield"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#4A5D23"
        android:layout_below="@id/imgWelcome"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnGetStarted"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_below="@id/txtWelcome"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:text="Get Started"
        android:backgroundTint="#4A5D23"
        android:textColor="#FFFFFF" />

</RelativeLayout>

